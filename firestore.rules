rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open to anyone with the site URL — no login in this app.
    // Scoped narrowly to only the two collections Command Board
    // uses, so nothing else in the project is exposed.
    match /icMeta/{docId} {
      allow read, write: if true;
    }
    match /icIncidents/{docId} {
      allow read, write: if true;
    }
  }
}
